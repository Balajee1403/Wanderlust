        </a>

    </div>

    <div class="destination-grid">

        <a href="/listings?search=Goa" class="destination-card">
            <img
                src="https://images.unsplash.com/photo-1512343879784-a960bf40e7f2"
                alt="Goa"
            >
            <div class="destination-overlay">
                <h3>Goa</h3>
                <p>Beach paradise</p>
            </div>
        </a>


        <a href="/listings?search=Manali" class="destination-card">
            <img
                src="https://images.unsplash.com/photo-1544735716-392fe2489ffa"
                alt="Manali"
            >
            <div class="destination-overlay">
                <h3>Manali</h3>
                <p>Mountain escape</p>
            </div>
        </a>


        <a href="/listings?search=Maldives" class="destination-card">
            <img
                src="https://images.unsplash.com/photo-1514282401047-d79a71a590e8"
                alt="Maldives"
            >
            <div class="destination-overlay">
                <h3>Maldives</h3>
                <p>Tropical getaway</p>
            </div>
        </a>


        <a href="/listings?search=Shimla" class="destination-card">
            <img
                src="https://images.unsplash.com/photo-1605649487212-47bdab064df7"
                alt="Shimla"
            >
            <div class="destination-overlay">
                <h3>Shimla</h3>
                <p>Peaceful hills</p>
            </div>
        </a>


        <a href="/listings?search=Ladakh" class="destination-card">
            <img
                src="https://images.unsplash.com/photo-1533130061792-64b345e4a833"
                alt="Ladakh"
            >
            <div class="destination-overlay">
                <h3>Leh Ladakh</h3>
                <p>Adventure awaits</p>
            </div>
        </a>

    </div>

</section>


<!-- ================= FEATURED STAYS ================= -->

<section class="home-section">

    <div class="section-heading">

        <h2>Featured Stays</h2>

        <a href="/listings">
            View all listings →
        </a>

    </div>


    <div class="featured-grid">

        <% if (featuredListings && featuredListings.length > 0) { %>

            <% for (let listing of featuredListings) { %>

                <div class="featured-card">

                    <a href="/listings/<%= listing._id %>">

                        <div class="featured-image-container">

                            <img
                                src="<%= listing.image.url %>"
                                alt="<%= listing.title %>"
                                class="featured-image"
                            >

                            <span class="heart-icon">
                                ♡
                            </span>

                        </div>

                    </a>


                    <div class="featured-info">

                        <h3>
                            <%= listing.title %>
                        </h3>

                        <p class="location">
                            📍 <%= listing.location %>,
                            <%= listing.country %>
                        </p>

                        <div class="featured-bottom">

                            <span>
                                ₹<%= Number(listing.price || 0)
                                    .toLocaleString("en-IN") %>
                                / night
                            </span>

                            <span class="rating">
                                ⭐ 4.8
                            </span>

                        </div>

                    </div>

                </div>

            <% } %>

        <% } else { %>

            <p>No featured listings available.</p>

        <% } %>

    </div>

</section>


