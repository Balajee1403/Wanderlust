<% layout("/layouts/boilerplate") %>

    <body>
        <h3>All Listings</h3>

        <% if (allListings.length===0) { %>

            <div class="text-center mt-5">
                <h4>No listings found</h4>
                <p>Try searching for another location, country, or listing name.</p>
            </div>

            <% } else { %>

                <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

                    <% for (let listing of allListings) { %>

                        <div class="col mb-4">

                            <!-- Card link -->
                            <a href="/listings/<%= listing._id %>" class="listing-link">

                                <div class="card">

                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image"
                                        style="height: 20rem" />

                                    <% const isWishlisted=currentUser && currentUser.wishlist.some( id=> id.toString()
                                        === listing._id.toString()
                                        );
                                        %>

                                        <form action="/listings/<%= listing._id %>/wishlist" method="POST"
                                            class="wishlist-form">
                                            <button type="submit" class="wishlist-btn">
                                                <i
                                                    class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
                                            </button>
                                        </form>

                                        <div class="card-body">
                                            <p class="card-text">
                                                <b>
                                                    <%= listing.title %>
                                                </b><br>
                                                ₹<%= Number(listing.price || 0).toLocaleString("en-IN") %> / night
                                            </p>
                                        </div>

                                </div>

                            </a>

                            <!-- ❤️ Wishlist button -->
                            <form action="/listings/<%= listing._id %>/wishlist" method="POST" class="wishlist-form">
                                <button type="submit" class="wishlist-btn">
                                    <i class="<%= isWishlisted ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
                                </button>
                            </form>

                        </div>

                        <% } %>

                </div>

                <% } %>
    </body>