<% layout("/layouts/boilerplate") %>

<body>
    <h3>All Listings</h3>

    <% if (allListings.length === 0) { %>

        <div class="text-center mt-5">
            <h4>No listings found</h4>
            <p>Try searching for another location, country, or listing name.</p>
        </div>

    <% } else { %>

        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

            <% for (let listings of allListings) { %>

                <a href="/listings/<%= listings._id %>" class="listing-link">

                    <div class="card col">
                        <img 
                            src="<%= listings.image.url %>" 
                            class="card-img-top" 
                            alt="listings_image" 
                            style="height: 20rem"
                        />

                        <div class="card-img-overlay"></div>

                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listings.title %></b><br>
                                &#8377;<%= Number(listings.price || 0).toLocaleString("en-IN") %> / night
                            </p>
                        </div>

                    </div>

                </a>

            <% } %>

        </div>

    <% } %>

</body>